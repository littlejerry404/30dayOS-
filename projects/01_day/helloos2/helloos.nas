; hello-os
; TAB=4

; 以下是标准FAT12格式软盘的相关描述

		DB		0xeb, 0x4e, 0x90
		DB		"HELLOIPL"		; 启动扇区的名称可以随意填写（8字节）
		DW		512				; 1个扇区的大小（必须设为512）
		DB		1				; 簇的大小（必须设为1个扇区）
		DW		1				; FAT从哪里开始（通常从第1个扇区开始）
		DB		2				; FAT的个数（必须设为2）
		DW		224				; 根目录区域的大小（通常设为224个目录项）
		DW		2880			; 该驱动器的大小（必须设为2880个扇区）
		DB		0xf0			; 介质类型（必须设为0xf0）
		DW		9				; FAT区域的长度（必须设为9个扇区）
		DW		18				; 每个磁道有多少个扇区（必须设为18）
		DW		2				; 磁头的数量（必须设为2）
		DD		0				; 因为没有使用分区，所以这里必须为0
		DD		2880			; 再写一次该驱动器的大小
		DB		0,0,0x29		; 虽然不太清楚，但保持这个值就行了
		DD		0xffffffff		; 大概是卷序列号
		DB		"HELLO-OS   "	; 磁盘的名称（11字节）
		DB		"FAT12   "		; 格式的名称（8字节）
		RESB	18				; 先预留18字节

; 程序主体

		DB		0xb8, 0x00, 0x00, 0x8e, 0xd0, 0xbc, 0x00, 0x7c
		DB		0x8e, 0xd8, 0x8e, 0xc0, 0xbe, 0x74, 0x7c, 0x8a
		DB		0x04, 0x83, 0xc6, 0x01, 0x3c, 0x00, 0x74, 0x09
		DB		0xb4, 0x0e, 0xbb, 0x0f, 0x00, 0xcd, 0x10, 0xeb
		DB		0xee, 0xf4, 0xeb, 0xfd

; 消息部分

		DB		0x0a, 0x0a		; 两个换行
		DB		"hello, world"
		DB		0x0a			; 换行
		DB		0

		RESB	0x1fe-$			; 用0x00填充到0x001fe为止的指令

		DB		0x55, 0xaa

; 下面是启动扇区以外部分的描述

		DB		0xf0, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00
		RESB	4600
		DB		0xf0, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00
		RESB	1469432
