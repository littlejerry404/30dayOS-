format:
	/* 在这一节中记述链接的方针 */
	code(align:1, logic:0x24,      file:0x24);
	data(align:4, logic:stack_end, file:code_end);

file:
	/* 在这一节中没有写进命令行
		记录.obj文件、.lib文件 */
	/* 另外，这个section也可以用完整路径来写。 */
	/* 例：  c:/osask/gg00libc.lib;  */
	../../z_tools/haribote/harilibc.lib;
	../../z_tools/haribote/golibc.lib;

label:
	/* 指定必须链接的标签 */
	/* 请理解为指定入口点即可 */
	_HariStartup;

	/* 上述3个section的顺序不能调换! */
